# Secretos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
engine/.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
npm-debug.log*
dist/
build/

# Índices generados (se regeneran con engine/indexing)
engine/indexing/indexes/*
!engine/indexing/indexes/.gitkeep

# Corpus crudo: descomentar si los archivos pesan mucho
# corpus/raw/*
# !corpus/raw/.gitkeep

# SO / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# PDFs subidos por /upload_pdf/ (y su texto y registro): no se suben
corpus/uploads/

# PDFs de docs (p. ej. el enunciado del curso): no se suben
docs/*.pdf

# Graphify (grafo local, no se versiona por ahora)
graphify-out/
