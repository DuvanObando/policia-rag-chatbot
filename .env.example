# Copiar a .env y completar. NUNCA versionar .env.
LLM_API_KEY=

# Motor de generación (engine/generation/llm.py)
LLM_PROVEEDOR=gemini
LLM_MODELO=gemini-3.5-flash-lite
LLM_MODELO_RESPALDO=gemini-3.6-flash
# Razonamiento de Gemini: minimal (más rápido, por defecto), low, medium, high u off
LLM_RAZONAMIENTO=minimal
GEMINI_API_KEY=

# Respaldo entre empresas: si los dos modelos de Gemini fallan, responde Groq (clave gratis en console.groq.com).
# Sin GROQ_API_KEY no hay respaldo externo. Varios modelos separados por coma: el límite gratuito de tokens
# por minuto es por modelo, así que ante un 429 pasa al siguiente.
GROQ_API_KEY=
LLM_GROQ_MODELO=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_S=15
# Orden de proveedores: groq,gemini (Groq primero) o gemini,groq. Vacía = LLM_PROVEEDOR primero y Groq de respaldo.
LLM_ORDEN=

# Corpus (engine/indexing/cargador_corpus.py). Relativa a la raíz del repo.
#   real (Fase 1): corpus/procesados/corpus_ley_1801.json   | muestra: corpus/muestra/codigo_muestra.json
CORPUS_RUTA=corpus/procesados/corpus_ley_1801.json
# 1 = indexar también los registros de normas que modifican la ley (por defecto no: su efecto ya está en el texto del artículo)
CORPUS_INCLUIR_REFORMAS=0
# Administración del corpus (agregar normas desde un PDF). Los dos se leen de ESTE .env (el de la raíz):
# lo usan el motor, el backend (backend/src/server.js) y el Docker (docker/docker-compose.yml).
# Genera valores largos y aleatorios, distintos entre sí, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nunca los pongas en el repo, en capturas ni en el chat del grupo.
#
# ADMIN_TOKEN: token que el BACKEND manda al motor en la cabecera X-Admin-Token (POST /corpus/reprocesar).
#   Nunca llega al navegador. Sin él, el motor responde 503 a /corpus/reprocesar.
ADMIN_TOKEN=
# ADMIN_CLAVE: clave que escribe la PERSONA en la pantalla «Administrador» del frontend; el backend la
#   compara (cabecera X-Admin-Clave) antes de dejarla subir PDF o reprocesar. Sin ella, esas rutas dan 503.
ADMIN_CLAVE=
# Norma con prioridad cuando la pregunta pide «artículo N» sin decir la norma (con varias normas cargadas).
# La respuesta avisa que otra norma cargada también tiene un artículo N. Vacía = Ley 1801 de 2016.
NORMA_PRINCIPAL=Ley 1801 de 2016

# Tema de cada artículo según la propuesta de Santiago Castro (32 temas por rangos de artículos,
# engine/retrieval/temas_por_articulo.json). 1 = activo (recomendado; ver docs/resultados_temas.md), 0 = el tema del corpus.
TEMAS_PROPUESTA=1

# Búsqueda (engine/retrieval/search.py): semantico | lexico | hibrido
BUSQUEDA_MODO=semantico
BUSQUEDA_RRF_K=60
# Expansión de consultas con glosario (solo BM25): 1 = activa, 0 = desactivada
BUSQUEDA_EXPANSION=1
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:3000
MOTOR_URL=http://localhost:8000
PORT=4000
