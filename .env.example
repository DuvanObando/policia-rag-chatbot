# Copiar a .env y completar. NUNCA versionar .env.
LLM_API_KEY=

# Motor de generación (engine/generation/llm.py)
LLM_PROVEEDOR=gemini
LLM_MODELO=gemini-3.5-flash-lite
LLM_MODELO_RESPALDO=gemini-3.6-flash
GEMINI_API_KEY=

# Corpus (engine/indexing/cargador_corpus.py). Relativa a la raíz del repo.
#   real (Fase 1): corpus/procesados/corpus_ley_1801.json   | muestra: corpus/muestra/codigo_muestra.json
CORPUS_RUTA=corpus/procesados/corpus_ley_1801.json
# 1 = indexar también los registros de normas que modifican la ley (por defecto no: su efecto ya está en el texto del artículo)
CORPUS_INCLUIR_REFORMAS=0

# Búsqueda (engine/retrieval/search.py): semantico | lexico | hibrido
BUSQUEDA_MODO=hibrido
BUSQUEDA_RRF_K=60
# Expansión de consultas con glosario (solo BM25): 1 = activa, 0 = desactivada
BUSQUEDA_EXPANSION=1
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:3000
MOTOR_URL=http://localhost:8000
PORT=4000
